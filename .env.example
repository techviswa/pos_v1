# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit it.
#
#   cp .env.example .env

# -------------------------------------------------------------------
# Backend
# -------------------------------------------------------------------
DATABASE_URL=sqlite:///./pos.db
SECRET_KEY=change-me-to-a-long-random-string

# -------------------------------------------------------------------
# Frontend (Vite exposes variables prefixed with VITE_)
# -------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

# -------------------------------------------------------------------
# API test suite  (python backend_test.py)
# -------------------------------------------------------------------
API_BASE_URL=http://localhost:8000
TEST_OWNER_EMAIL=owner@pos.com
TEST_OWNER_PASSWORD=admin123

# -------------------------------------------------------------------
# AdminCore bridge
# -------------------------------------------------------------------
ADMINCORE_API_BASE_URL=http://localhost:8000
ADMINCORE_API_KEY=dev-admincore-pos-bridge-key
ADMINCORE_ENABLED=true
POS_BASE_URL=http://localhost:4001
