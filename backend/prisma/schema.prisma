generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BackgroundJob {
  id          String    @id @default(cuid())
  type        String
  status      String    @default("queued")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  payload     Json
  result      Json?
  error       String?
  runAt       DateTime  @default(now())
  leaseUntil  DateTime?
  leaseToken  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
}

model AdminCoreSyncLog {
  id        String   @id @default(cuid())
  tenantId  String?
  resource  String
  status    String
  data      Json
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

model StateDocument {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

model DocumentSequence {
  key   String @id
  value Int
}

model AuthSession {
  tokenHash String   @id
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model Business {
  id                      String                   @id @default(cuid())
  name                    String
  tenantId                String                   @unique
  users                   User[]
  outlets                 Outlet[]
  products                Product[]
  orders                  Order[]
  bills                   Bill[]
  inventoryItems          InventoryItem[]
  purchaseOrders          PurchaseOrder[]
  allocations             Allocation[]
  routePlans              RoutePlan[]
  kitchenTickets          KitchenTicket[]
  batches                 Batch[]
  tableManagementSettings TableManagementSettings?
  diningAreas             DiningArea[]
  diningTables            DiningTable[]
  tableQrCodes            TableQrCode[]
  tableSessions           TableSession[]
  tableReservations       TableReservation[]
  feedback                Feedback[]
  featureToggles          FeatureToggle[]
  priceRules              PriceRule[]
  attendanceEntries       AttendanceEntry[]
  tips                    Tip[]
  tipPayouts              TipPayout[]
  customers               Customer[]
  loyaltyEntries          LoyaltyEntry[]
  giftCards               GiftCard[]
  giftCardTransactions    GiftCardTransaction[]
  payProfiles             PayProfile[]
  payrollRuns             PayrollRun[]
  payslips                Payslip[]
  marketingConfig         MarketingConfig?
  marketingTemplates      MarketingTemplate[]
  marketingCampaigns      MarketingCampaign[]
  marketingMessages       MarketingMessage[]
  paymentGateway          PaymentGatewayConfig?
  paymentGatewayEvents    PaymentGatewayEvent[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id        String           @id @default(cuid())
  key       String           @unique
  label     String
  roles     RolePermission[]
  users     UserPermission[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserPermission {
  userId       String
  permissionId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

model User {
  id                  String                 @id @default(cuid())
  businessId          String
  roleId              String?
  name                String
  email               String
  passwordHash        String
  profileRequired     Boolean                @default(true)
  active              Boolean                @default(true)
  bio                 Json?
  role                Role?                  @relation(fields: [roleId], references: [id])
  business            Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  permissions         UserPermission[]
  outletAssignments   UserOutletAssignment[]
  activities          StaffActivity[]
  authTokens          AuthToken[]
  purchaseOrders      PurchaseOrder[]
  // Optional 4-6 digit PIN for the shared time clock; failures lock the PIN for a while.
  clockPinHash        String?
  clockPinFailures    Int                    @default(0)
  clockPinLockedUntil DateTime?
  attendanceEntries   AttendanceEntry[]
  tipsReceived        Tip[]
  tipPayouts          TipPayout[]
  payProfile          PayProfile?
  payslips            Payslip[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@unique([businessId, email])
}

model AuthToken {
  id        String    @id @default(cuid())
  token     String    @unique
  type      String
  userId    String?
  metadata  Json?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type, expiresAt])
  @@index([userId])
}

model Outlet {
  id              String                 @id @default(cuid())
  businessId      String
  name            String
  code            String
  location        String?
  managerName     String?
  phone           String?
  status          String                 @default("active")
  business        Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userAssignments UserOutletAssignment[]
  productLinks    OutletProduct[]
  inventoryLinks  OutletInventory[]
  featureToggles  OutletFeatureToggle[]
  purchaseOrders  PurchaseOrder[]
  allocations     Allocation[]
  routeStops      RouteStop[]
  orders          Order[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([businessId, code])
}

model UserOutletAssignment {
  userId   String
  outletId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  outlet   Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@id([userId, outletId])
}

model Product {
  id              String           @id @default(cuid())
  businessId      String
  name            String
  price           Decimal          @db.Decimal(12, 2)
  costPrice       Decimal          @default(0) @db.Decimal(18, 6)
  stock           Int              @default(0)
  active          Boolean          @default(true)
  category        String
  dietaryType     String           @default("Veg")
  channelSettings Json?
  outletOverrides Json?
  removalOptions  Json?
  recipeLines     Json?
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  variations      Variation[]
  addons          Addon[]
  outletLinks     OutletProduct[]
  orderItems      OrderItem[]
  billItems       BillItem[]
  // A combo is sold as one product; its stock and recipes come from its components.
  isCombo         Boolean          @default(false)
  modifierGroups  ModifierGroup[]
  comboComponents ComboComponent[] @relation("ComboParent")
  usedInCombos    ComboComponent[] @relation("ComboPart")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([businessId, name])
}

/// "Choose your bread (1)", "Extra toppings (up to 3)". The server enforces minSelect/maxSelect when pricing.
model ModifierGroup {
  id        String           @id @default(cuid())
  productId String
  name      String
  minSelect Int              @default(0)
  maxSelect Int              @default(1)
  sortOrder Int              @default(0)
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  options   ModifierOption[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([productId])
}

model ModifierOption {
  id              String        @id @default(cuid())
  groupId         String
  name            String
  price           Decimal       @default(0) @db.Decimal(12, 2)
  // Choosing this option also sells one unit of this product (e.g. the drink in a meal deal).
  linkedProductId String?
  recipeLines     Json?
  active          Boolean       @default(true)
  sortOrder       Int           @default(0)
  group           ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model ComboComponent {
  id                 String  @id @default(cuid())
  comboProductId     String
  componentProductId String
  quantity           Int     @default(1)
  combo              Product @relation("ComboParent", fields: [comboProductId], references: [id], onDelete: Cascade)
  // NoAction: a product that is part of a combo cannot be deleted on its own (a business delete still cascades).
  component          Product @relation("ComboPart", fields: [componentProductId], references: [id], onDelete: NoAction)

  @@unique([comboProductId, componentProductId])
  @@index([componentProductId])
}

/// Happy hours and other time-based prices. Empty lists mean "all" (outlets, channels, products).
model PriceRule {
  id           String    @id @default(cuid())
  businessId   String
  name         String
  active       Boolean   @default(true)
  // percent_off | amount_off | fixed_price
  discountType String
  value        Decimal   @db.Decimal(12, 2)
  // 0 = Sunday ... 6 = Saturday; empty = every day
  daysOfWeek   Int[]
  // Minutes after local midnight. endMinute <= startMinute means the window runs past midnight.
  startMinute  Int
  endMinute    Int
  timezone     String    @default("Asia/Kolkata")
  channels     String[]
  outletIds    String[]
  productIds   String[]
  categories   String[]
  validFrom    DateTime?
  validTo      DateTime?
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([businessId, active])
}

model Variation {
  id          String   @id @default(cuid())
  productId   String
  name        String
  price       Decimal  @default(0) @db.Decimal(12, 2)
  recipeLines Json?
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Addon {
  id              String   @id @default(cuid())
  productId       String
  linkedProductId String?
  name            String
  price           Decimal  @default(0) @db.Decimal(12, 2)
  recipeLines     Json?
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Order {
  id             String          @id @default(cuid())
  businessId     String
  outletId       String?
  trackingToken  String?         @unique
  customerName   String
  channel        String
  total          Decimal         @default(0) @db.Decimal(12, 2)
  status         String
  metadata       Json?
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet         Outlet?         @relation(fields: [outletId], references: [id])
  items          OrderItem[]
  bill           Bill?
  kitchenTickets KitchenTicket[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String?
  name      String
  quantity  Int
  price     Decimal  @db.Decimal(12, 2)
  variation String?
  addons    Json?
  // What was chosen and charged: modifier options, combo components, price rule. Fixed at sale time.
  modifiers Json?
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id])
}

model Bill {
  id            String     @id @default(cuid())
  businessId    String
  orderId       String?    @unique
  customerName  String
  currency      String
  subtotal      Decimal    @default(0) @db.Decimal(12, 2)
  tax           Decimal    @default(0) @db.Decimal(12, 2)
  total         Decimal    @default(0) @db.Decimal(12, 2)
  status        String
  kitchenStatus String?
  // Real column (not only metadata) so the database guarantees one invoice number per business.
  invoiceNumber String?
  metadata      Json?
  business      Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // NoAction: a billed order cannot be deleted on its own (checked at statement end, so a business delete still cascades).
  order         Order?     @relation(fields: [orderId], references: [id], onDelete: NoAction)
  items         BillItem[]
  feedback      Feedback[]
  tip           Tip?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([businessId, invoiceNumber])
}

model BillItem {
  id        String   @id @default(cuid())
  billId    String
  productId String?
  name      String
  quantity  Int
  price     Decimal  @db.Decimal(12, 2)
  variation String?
  addons    Json?
  // What was chosen and charged: modifier options, combo components, price rule. Fixed at sale time.
  modifiers Json?
  bill      Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id])
}

model InventoryItem {
  id              String              @id @default(cuid())
  businessId      String
  name            String
  stock           Float               @default(0)
  unit            String
  reorderLevel    Float               @default(0)
  vendor          String?
  storageLocation String?
  notes           String?
  expiryDate      DateTime?
  conversionCost  Decimal             @default(0) @db.Decimal(18, 6)
  business        Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outletLinks     OutletInventory[]
  movements       InventoryMovement[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([businessId, name])
}

model OutletProduct {
  id            String   @id @default(cuid())
  outletId      String
  productId     String
  enabled       Boolean  @default(true)
  priceOverride Decimal? @db.Decimal(12, 2)
  outlet        Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([outletId, productId])
}

model OutletInventory {
  id              String        @id @default(cuid())
  outletId        String
  inventoryItemId String
  stock           Float         @default(0)
  unitCost        Decimal?      @db.Decimal(18, 6)
  reorderLevel    Float         @default(0)
  enabled         Boolean       @default(true)
  outlet          Outlet        @relation(fields: [outletId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([outletId, inventoryItemId])
}

model OutletFeatureToggle {
  id         String   @id @default(cuid())
  outletId   String
  featureKey String
  enabled    Boolean  @default(true)
  outlet     Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([outletId, featureKey])
}

model InventoryMovement {
  id              String        @id @default(cuid())
  sequence        Int           @default(autoincrement())
  businessId      String
  inventoryItemId String
  movementType    String
  quantity        Float
  outletId        String?
  unitCost        Decimal?      @db.Decimal(18, 6)
  quantityBefore  Float?
  quantityAfter   Float?
  valueBefore     Decimal?      @db.Decimal(18, 6)
  valueAfter      Decimal?      @db.Decimal(18, 6)
  referenceId     String?
  reason          String?
  expiryDate      DateTime?
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@index([businessId, inventoryItemId, outletId, createdAt])
}

model PurchaseOrder {
  id            String       @id @default(cuid())
  businessId    String
  outletId      String
  requestedById String?
  priority      String?
  requiredBy    DateTime?
  notes         String?
  status        String
  items         Json
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet        Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)
  requestedBy   User?        @relation(fields: [requestedById], references: [id])
  allocations   Allocation[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Allocation {
  id              String         @id @default(cuid())
  businessId      String
  outletId        String
  purchaseOrderId String?
  routePlanId     String?
  sourceLocation  String
  status          String
  items           Json
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outlet          Outlet         @relation(fields: [outletId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  routePlan       RoutePlan?     @relation(fields: [routePlanId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model RoutePlan {
  id            String       @id @default(cuid())
  businessId    String
  routeName     String
  dispatchDate  DateTime?
  driverName    String?
  vehicleNumber String?
  status        String
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stops         RouteStop[]
  allocations   Allocation[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model RouteStop {
  id          String    @id @default(cuid())
  routePlanId String
  outletId    String
  sequence    Int
  eta         String?
  routePlan   RoutePlan @relation(fields: [routePlanId], references: [id], onDelete: Cascade)
  outlet      Outlet    @relation(fields: [outletId], references: [id], onDelete: Cascade)
}

model KitchenTicket {
  id         String   @id @default(cuid())
  businessId String
  orderId    String   @unique
  status     String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Batch {
  id         String   @id @default(cuid())
  businessId String
  sku        String
  batchNo    String
  expiryDate DateTime
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TableManagementSettings {
  id               String   @id @default(cuid())
  businessId       String   @unique
  nichePreset      String   @default("restaurant")
  serviceMode      String   @default("full_service")
  capabilities     Json?
  reservationRules Json?
  uiPreferences    Json?
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model DiningArea {
  id         String        @id @default(cuid())
  businessId String
  name       String
  code       String?
  sortOrder  Int           @default(0)
  active     Boolean       @default(true)
  meta       Json?
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tables     DiningTable[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([businessId, name])
}

model DiningTable {
  id            String             @id @default(cuid())
  businessId    String
  areaId        String?
  name          String
  code          String?
  seats         Int                @default(4)
  status        String             @default("available")
  active        Boolean            @default(true)
  shape         String?
  sortOrder     Int                @default(0)
  meta          Json?
  business      Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  area          DiningArea?        @relation(fields: [areaId], references: [id], onDelete: SetNull)
  qrCode        TableQrCode?
  tableSessions TableSession[]
  reservations  TableReservation[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([businessId, name])
}

model TableQrCode {
  id            String             @id @default(cuid())
  businessId    String
  tableId       String             @unique
  token         String             @unique
  active        Boolean            @default(true)
  scanCount     Int                @default(0)
  lastScannedAt DateTime?
  business      Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  table         DiningTable        @relation(fields: [tableId], references: [id], onDelete: Cascade)
  scanEvents    TableQrScanEvent[]
  tableSessions TableSession[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  rotatedAt     DateTime?
}

model TableQrScanEvent {
  id         String      @id @default(cuid())
  qrCodeId   String
  qrCode     TableQrCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  businessId String
  tableId    String
  userAgent  String?
  referrer   String?
  ipHash     String?
  scannedAt  DateTime    @default(now())

  @@index([qrCodeId, scannedAt])
  @@index([businessId, scannedAt])
  @@index([tableId, scannedAt])
}

model TableSession {
  id            String       @id @default(cuid())
  businessId    String
  tableId       String
  qrCodeId      String?
  sessionKey    String       @unique
  source        String       @default("qr")
  status        String       @default("active")
  customerName  String?
  customerPhone String?
  guestCount    Int?
  metadata      Json?
  openedAt      DateTime     @default(now())
  closedAt      DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  table         DiningTable  @relation(fields: [tableId], references: [id], onDelete: Cascade)
  qrCode        TableQrCode? @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)

  @@index([businessId, status])
  @@index([tableId, status])
  @@index([qrCodeId])
}

model TableReservation {
  id              String       @id @default(cuid())
  businessId      String
  tableId         String?
  customerName    String?
  customerPhone   String?
  reservationDate DateTime?
  status          String       @default("reserved")
  guestsCount     Int?
  notes           String?
  source          String?
  meta            Json?
  confirmedAt     DateTime?
  releasedAt      DateTime?
  canceledAt      DateTime?
  business        Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  table           DiningTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Feedback {
  id           String   @id @default(cuid())
  businessId   String
  billId       String?
  token        String?  @unique
  customerName String?
  rating       Int?
  comment      String?
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bill         Bill?    @relation(fields: [billId], references: [id])
  createdAt    DateTime @default(now())
}

model FeatureToggle {
  id         String   @id @default(cuid())
  businessId String
  featureKey String
  enabled    Boolean  @default(true)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, featureKey])
}

model StaffActivity {
  id        String   @id @default(cuid())
  userId    String
  action    String
  actorName String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One clock-in to clock-out. Staff names are copied so the history survives if the account is deleted.
model AttendanceEntry {
  id           String    @id @default(cuid())
  businessId   String
  outletId     String?
  userId       String?
  userName     String
  userRole     String?
  clockInAt    DateTime
  clockOutAt   DateTime?
  // [{ start_at, end_at }] - end_at is null while the break is running.
  breaks       Json      @default("[]")
  source       String    @default("self")
  note         String?
  // Every manager change: [{ at, by, by_name, reason, before }]
  edits        Json      @default("[]")
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([businessId, clockInAt])
  @@index([userId, clockInAt])
}

// A tip received on a bill, from a QR order, or declared by staff (cash handed over directly).
model Tip {
  id            String    @id @default(cuid())
  businessId    String
  outletId      String?
  billId        String?   @unique
  // Pooled tips are shared by hours worked; others go to one person.
  pooled        Boolean   @default(false)
  userId        String?
  recipientName String?
  amount        Decimal   @db.Decimal(12, 2)
  source        String
  method        String?
  note          String?
  createdById   String?
  createdByName String?
  voidedAt      DateTime?
  voidedById    String?
  voidReason    String?
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bill          Bill?     @relation(fields: [billId], references: [id], onDelete: Cascade)
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([businessId, createdAt])
  @@index([userId])
}

// Tips handed to a staff member for a period.
model TipPayout {
  id              String    @id @default(cuid())
  businessId      String
  outletId        String?
  userId          String?
  userName        String
  amount          Decimal   @db.Decimal(12, 2)
  periodFrom      DateTime
  periodTo        DateTime
  method          String
  note            String?
  paidById        String?
  paidByName      String?
  clientRequestId String?
  voidedAt        DateTime?
  voidedById      String?
  voidReason      String?
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())

  @@unique([businessId, clientRequestId])
  @@index([businessId, periodFrom])
  @@index([userId])
}

// A guest known by phone number. Visit and spend figures are kept up to date by billing.
model Customer {
  id                 String             @id @default(cuid())
  businessId         String
  // Digits only, national number (e.g. 10 digits in India).
  phone              String
  name               String
  email              String?
  birthday           DateTime?
  anniversary        DateTime?
  gender             String?
  notes              String?
  tags               String[]           @default([])
  marketingOptIn     Boolean            @default(false)
  // When consent was given or withdrawn (e.g. by replying STOP).
  marketingConsentAt DateTime?
  marketingOptOutAt  DateTime?
  loyaltyPoints      Int                @default(0)
  visitCount         Int                @default(0)
  totalSpent         Decimal            @default(0) @db.Decimal(14, 2)
  firstVisitAt       DateTime?
  lastVisitAt        DateTime?
  // Set when the guest asked for their data to be erased; the record stays so bills remain consistent.
  anonymizedAt       DateTime?
  business           Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  loyaltyEntries     LoyaltyEntry[]
  giftCards          GiftCard[]
  marketingMessages  MarketingMessage[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([businessId, phone])
  @@index([businessId, lastVisitAt])
}

// Points ledger. The customer's balance always equals the sum of its entries.
model LoyaltyEntry {
  id            String    @id @default(cuid())
  businessId    String
  customerId    String
  billId        String?
  // earn | redeem | reverse_earn | reverse_redeem | adjust | expire
  type          String
  points        Int
  value         Decimal?  @db.Decimal(12, 2)
  balanceAfter  Int
  expiresAt     DateTime?
  note          String?
  createdById   String?
  createdByName String?
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())

  @@index([customerId, createdAt])
  @@index([billId])
}

model GiftCard {
  id             String                @id @default(cuid())
  businessId     String
  // Uppercase, no separators. Long and random, so it cannot be guessed.
  code           String                @unique
  initialValue   Decimal               @db.Decimal(12, 2)
  balance        Decimal               @db.Decimal(12, 2)
  // pending_payment | active | blocked | void
  status         String
  expiresAt      DateTime?
  customerId     String?
  recipientName  String?
  recipientPhone String?
  outletId       String?
  note           String?
  createdById    String?
  createdByName  String?
  business       Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer       Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  transactions   GiftCardTransaction[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([businessId, createdAt])
}

model GiftCardTransaction {
  id                String   @id @default(cuid())
  businessId        String
  giftCardId        String
  // issue | redeem | refund | void | adjust
  type              String
  amount            Decimal  @db.Decimal(12, 2)
  balanceAfter      Decimal  @db.Decimal(12, 2)
  billId            String?
  paymentMethod     String?
  paymentReference  String?
  settlementShiftId String?
  outletId          String?
  clientRequestId   String?
  note              String?
  createdById       String?
  createdByName     String?
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  giftCard          GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@unique([businessId, clientRequestId])
  @@index([giftCardId, createdAt])
  @@index([billId])
  @@index([settlementShiftId])
}

// How a staff member is paid.
model PayProfile {
  id               String   @id @default(cuid())
  businessId       String
  userId           String   @unique
  // monthly | daily | hourly
  payType          String
  monthlySalary    Decimal  @default(0) @db.Decimal(12, 2)
  dailyRate        Decimal  @default(0) @db.Decimal(12, 2)
  hourlyRate       Decimal  @default(0) @db.Decimal(12, 2)
  // Share of earned pay that is basic wage (used for PF).
  basicPercent     Decimal  @default(50) @db.Decimal(5, 2)
  // [{ name, amount }] fixed every month
  allowances       Json     @default("[]")
  deductions       Json     @default("[]")
  pfEnabled        Boolean  @default(false)
  esiEnabled       Boolean  @default(false)
  professionalTax  Decimal  @default(0) @db.Decimal(10, 2)
  overtimeEligible Boolean  @default(false)
  pan              String?
  uan              String?
  esiNumber        String?
  bankName         String?
  bankAccountLast4 String?
  ifsc             String?
  active           Boolean  @default(true)
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PayrollRun {
  id            String    @id @default(cuid())
  businessId    String
  periodFrom    DateTime
  periodTo      DateTime
  label         String
  // draft | finalized | void
  status        String    @default("draft")
  note          String?
  createdById   String?
  createdByName String?
  finalizedAt   DateTime?
  finalizedById String?
  voidedAt      DateTime?
  voidReason    String?
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payslips      Payslip[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([businessId, periodFrom])
}

model Payslip {
  id                    String     @id @default(cuid())
  businessId            String
  runId                 String
  userId                String?
  userName              String
  role                  String?
  // Pay profile and employee details as they were for this payslip.
  profile               Json
  daysInPeriod          Int
  daysPresent           Int
  lopDays               Decimal    @default(0) @db.Decimal(5, 2)
  hoursWorked           Decimal    @default(0) @db.Decimal(8, 2)
  overtimeHours         Decimal    @default(0) @db.Decimal(8, 2)
  // Manual lines entered before finalising: [{ kind: earning|deduction, name, amount }]
  manualLines           Json       @default("[]")
  earnings              Json       @default("[]")
  deductions            Json       @default("[]")
  employerContributions Json       @default("[]")
  gross                 Decimal    @db.Decimal(12, 2)
  totalDeductions       Decimal    @db.Decimal(12, 2)
  netPay                Decimal    @db.Decimal(12, 2)
  tipsPaid              Decimal    @default(0) @db.Decimal(12, 2)
  paidAt                DateTime?
  paymentMethod         String?
  paymentReference      String?
  business              Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  run                   PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  user                  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@unique([runId, userId])
  @@index([userId])
}

// A business's own WhatsApp Business / SMS accounts. Secrets are stored encrypted (AES-256-GCM).
model MarketingConfig {
  id                        String   @id @default(cuid())
  businessId                String   @unique
  whatsappEnabled           Boolean  @default(false)
  whatsappPhoneNumberId     String?  @unique
  whatsappBusinessAccountId String?
  whatsappAccessTokenEnc    String?
  whatsappAppSecretEnc      String?
  whatsappVerifyToken       String?
  smsEnabled                Boolean  @default(false)
  // twilio | msg91 | webhook
  smsProvider               String?
  smsSenderId               String?
  smsDltEntityId            String?
  smsCredentialsEnc         String?
  // Secret in the URL of this business's SMS delivery/opt-out webhooks.
  smsWebhookKey             String   @unique
  // Local minutes of the day between which promotions may be sent (TRAI: 10:00-21:00 for promotional SMS).
  sendWindowStart           Int      @default(600)
  sendWindowEnd             Int      @default(1260)
  utcOffsetMinutes          Int      @default(330)
  // Most promotional messages one customer gets in 7 days.
  weeklyCap                 Int      @default(2)
  whatsappCostPerMessage    Decimal  @default(0.88) @db.Decimal(8, 4)
  smsCostPerMessage         Decimal  @default(0.25) @db.Decimal(8, 4)
  business                  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

// A message approved by Meta (WhatsApp) or registered on DLT (SMS), with how its placeholders are filled.
model MarketingTemplate {
  id                   String              @id @default(cuid())
  businessId           String
  // whatsapp | sms
  channel              String
  name                 String
  // WhatsApp: approved template name and language code.
  whatsappTemplateName String?
  language             String?
  // SMS: DLT template id, and the provider's own template/flow id where it has one (MSG91).
  dltTemplateId        String?
  providerTemplateId   String?
  // Text with {{1}}, {{2}}... (WhatsApp) or {#var#} (SMS) placeholders, for previews and SMS sending.
  body                 String
  // One entry per placeholder: { source: "field", value: "first_name" } or { source: "text", value: "20% off" }
  variables            Json                @default("[]")
  business             Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaigns            MarketingCampaign[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([businessId])
}

model MarketingCampaign {
  id            String             @id @default(cuid())
  businessId    String
  name          String
  channel       String
  templateId    String
  // one_time | birthday | anniversary | winback
  kind          String             @default("one_time")
  audience      Json               @default("{}")
  // one_time: draft | scheduled | sending | completed | cancelled
  // automations: active | paused
  status        String             @default("draft")
  scheduledAt   DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  // Automations: local hour to send and the last local date they ran.
  sendHour      Int?
  lastRunOn     String?
  createdById   String?
  createdByName String?
  business      Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  template      MarketingTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  messages      MarketingMessage[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([businessId, status])
}

model MarketingMessage {
  id                String            @id @default(cuid())
  businessId        String
  campaignId        String
  customerId        String
  // Automations run once per day; one-time campaigns use "once". One message per person per run.
  runKey            String            @default("once")
  channel           String
  phone             String
  body              String?
  // queued | sending | sent | delivered | read | failed | skipped
  status            String            @default("queued")
  skipReason        String?
  providerMessageId String?
  error             String?
  attempts          Int               @default(0)
  nextAttemptAt     DateTime          @default(now())
  lockedUntil       DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  business          Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaign          MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer          Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([campaignId, customerId, runKey])
  @@index([status, nextAttemptAt])
  @@index([providerMessageId])
  @@index([customerId, sentAt])
}

// A restaurant's own Razorpay account. The key secret and webhook secret are stored encrypted.
model PaymentGatewayConfig {
  id               String   @id @default(cuid())
  businessId       String   @unique
  provider         String   @default("razorpay")
  enabled          Boolean  @default(false)
  keyId            String?
  keySecretEnc     String?
  webhookSecretEnc String?
  // Secret in this business's webhook URL; identifies the business before the signature is checked.
  webhookKey       String   @unique
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Gateway webhook events already applied, so a redelivered event never counts money twice.
model PaymentGatewayEvent {
  id         String   @id
  businessId String
  event      String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
}
