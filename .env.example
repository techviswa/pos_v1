# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit it.
#
#   cp .env.example .env

# -------------------------------------------------------------------
# Backend
# -------------------------------------------------------------------
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./dev.db
JWT_SECRET=change-me-to-a-long-random-string

# -------------------------------------------------------------------
# Frontend (Create React App exposes variables prefixed with REACT_APP_)
# -------------------------------------------------------------------
REACT_APP_BACKEND_URL=http://localhost:4001
REACT_APP_PUBLIC_FRONTEND_URL=http://localhost:3002
GENERATE_SOURCEMAP=false

# -------------------------------------------------------------------
# API test suite  (python backend_test.py)
# -------------------------------------------------------------------
API_BASE_URL=http://localhost:4001
TEST_OWNER_EMAIL=owner@pos.com
TEST_OWNER_PASSWORD=admin123

# -------------------------------------------------------------------
# AdminCore bridge
# -------------------------------------------------------------------
ADMINCORE_API_BASE_URL=http://localhost:8000
ADMINCORE_API_KEY=dev-admincore-pos-bridge-key
ADMINCORE_ENABLED=true
POS_BASE_URL=http://localhost:4001
