# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDE and editors
.idea/
.vscode/

# Dependencies
node_modules/
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js / Vite build output
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Production builds
/build
dist/
dist

# Environment files — keep .env.example committed; NEVER commit .env or any variant with real secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# FIX: The original pattern ".env.*" would ALSO exclude ".env.example".
# We use explicit negation to keep it tracked:
!.env.example
*token.json*
*credentials.json*

# Logs and debug files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb
backend/logs/
frontend/build-output.txt
test_result*.md

# System files
.DS_Store
*.pem

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/

# Development tools
chainlit.md
.chainlit
.ipynb_checkpoints/
.ac

# Deployment
.vercel

# Data and databases
*.db
*.sqlite
*.sqlite3
pos.db
backend/data/

# Archive files and large assets
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# Build caches
.cache/

# Duplicate lockfiles generated by Windows copy operations
/yarn (1).lock

# Secrets / credentials — never commit these
memory/test_credentials.md

# Mobile development cache
android-sdk/frontend/node_modules/.cache/
frontend/node_modules/.cache/
